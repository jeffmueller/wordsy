# Template — rendered by setup-pi.sh using the values in .env.deploy.
# ${DOMAIN}, ${PI_USER} and ${DEPLOY_DIR} are substituted at deploy time.

server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    access_log /var/log/nginx/wordsy-access.log combined;

    root /home/${PI_USER}/${DEPLOY_DIR}/site;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Static asset caching (CSS, JS, SVG)
    #
    # Filenames are not content-hashed, so these cannot be immutable: a deploy
    # has to reach browsers that already loaded the old files. An hour, then a
    # cheap ETag revalidation. Using `expires` rather than `add_header` also
    # keeps the security headers above inherited into this location.
    location ~* \.(css|js|svg|ico)$ {
        expires 1h;
    }

    # Main location
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Block common attack patterns
    location ~ /\. {
        deny all;
    }

    location ~* (wp-admin|wp-login|xmlrpc|\.php|\.env|\.git|\.sql) {
        return 444;
    }
}
